{
  "compilerOptions": {
    "sourceMap": false,
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "target": "es2018",
    "lib": ["es2018"],
    "declaration": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules/**/*", "dist", "examples"]
}
